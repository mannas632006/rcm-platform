{
  "components": {
    "schemas": {
      "DeadlineRiskOut": {
        "description": "UR-26: the alert bar that cannot be dismissed while claims are at risk.",
        "properties": {
          "charges": {
            "description": "Billed charges of the claims at risk, as an exact decimal string to the cent.",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Charges",
            "type": "string"
          },
          "claims": {
            "title": "Claims",
            "type": "integer"
          }
        },
        "required": [
          "claims",
          "charges"
        ],
        "title": "DeadlineRiskOut",
        "type": "object"
      },
      "Me": {
        "description": "Who is signed in, and what they may do. No PHI: a staff identity.",
        "properties": {
          "client_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Client Ids",
            "type": "array"
          },
          "permissions": {
            "items": {
              "$ref": "#/components/schemas/Permission"
            },
            "title": "Permissions",
            "type": "array"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/Role"
            },
            "title": "Roles",
            "type": "array"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          }
        },
        "required": [
          "subject",
          "roles",
          "permissions",
          "client_ids"
        ],
        "title": "Me",
        "type": "object"
      },
      "Permission": {
        "description": "What a principal may do. Checked, never inferred from the role name.",
        "enum": [
          "claim:read",
          "claim:write",
          "claim:submit",
          "denial:read",
          "denial:disposition",
          "appeal:sign",
          "coding:read",
          "coding:write",
          "rule:read",
          "rule:author",
          "rule:promote",
          "payer_registry:write",
          "report:read",
          "audit:read",
          "user:admin"
        ],
        "title": "Permission",
        "type": "string"
      },
      "Problem": {
        "description": "RFC 7807 Problem Details (FR-API-04): every error the API returns.\n\nDeclared on each route so the generated client types the error body too.",
        "properties": {
          "code": {
            "description": "Machine-readable error code, stable across releases.",
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Correlates to logs (FR-API-03).",
            "title": "Request Id"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ],
        "title": "Problem",
        "type": "object"
      },
      "QueueSummaryOut": {
        "properties": {
          "key": {
            "description": "Stable queue identifier, used in URLs.",
            "title": "Key",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "mine": {
            "description": "Open items held by the signed-in operator.",
            "title": "Mine",
            "type": "integer"
          },
          "open": {
            "title": "Open",
            "type": "integer"
          },
          "overdue": {
            "description": "Open items past their SLA.",
            "title": "Overdue",
            "type": "integer"
          },
          "pinned": {
            "description": "Deadline-pinned items (PD-15), always shown first.",
            "title": "Pinned",
            "type": "integer"
          },
          "unassigned": {
            "title": "Unassigned",
            "type": "integer"
          }
        },
        "required": [
          "key",
          "label",
          "open",
          "unassigned",
          "mine",
          "pinned",
          "overdue"
        ],
        "title": "QueueSummaryOut",
        "type": "object"
      },
      "Role": {
        "description": "Operator roles (SRS section 11.5).\n\nDeliberately coarse. A role per job title produces a matrix nobody maintains;\nthese are the five distinct *authority levels* the work actually has.",
        "enum": [
          "AR_SPECIALIST",
          "DENIAL_SPECIALIST",
          "CODER",
          "OPERATIONS_MANAGER",
          "RULES_AUTHOR",
          "ADMINISTRATOR",
          "SYSTEM"
        ],
        "title": "Role",
        "type": "string"
      },
      "WorkQueues": {
        "properties": {
          "queues": {
            "items": {
              "$ref": "#/components/schemas/QueueSummaryOut"
            },
            "title": "Queues",
            "type": "array"
          }
        },
        "required": [
          "queues"
        ],
        "title": "WorkQueues",
        "type": "object"
      }
    },
    "securitySchemes": {
      "OIDC bearer token": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "RCM Automation Platform",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/alerts/deadline-risk": {
      "get": {
        "description": "UR-26's alert: claims whose filing deadline has pinned their work, and\ntheir billed charges. Claim money, so it needs `claim:read`.",
        "operationId": "getDeadlineRisk",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeadlineRiskOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No valid bearer token."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The token lacks the permission this route needs."
          }
        },
        "security": [
          {
            "OIDC bearer token": []
          }
        ],
        "summary": "Claims at filing-deadline risk",
        "tags": [
          "shell"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "description": "The signed-in operator's roles, permissions and client scope.",
        "operationId": "getMe",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No valid bearer token."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The token lacks the permission this route needs."
          }
        },
        "security": [
          {
            "OIDC bearer token": []
          }
        ],
        "summary": "Who is signed in",
        "tags": [
          "shell"
        ]
      }
    },
    "/api/v1/work-queues": {
      "get": {
        "description": "Each queue the operator's role may work, with its open work, inside\nthe operator's client scope (SRS 7.2, PD-20).",
        "operationId": "listWorkQueues",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkQueues"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No valid bearer token."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The token lacks the permission this route needs."
          }
        },
        "security": [
          {
            "OIDC bearer token": []
          }
        ],
        "summary": "Queues visible to me",
        "tags": [
          "shell"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Liveness. Deliberately does not touch the database.\n\nA health check that fails when Postgres is briefly unavailable causes the\norchestrator to kill an application that would otherwise have recovered.\nDependency status belongs in a separate readiness probe.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "platform"
        ]
      }
    }
  }
}
