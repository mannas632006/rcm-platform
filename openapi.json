{
  "components": {
    "schemas": {
      "Assignment": {
        "enum": [
          "any",
          "mine",
          "unassigned"
        ],
        "title": "Assignment",
        "type": "string"
      },
      "DashboardOut": {
        "description": "KPIs for the signed-in operator's clients. Counts and rates only.",
        "properties": {
          "adjudicated_claims": {
            "title": "Adjudicated Claims",
            "type": "integer"
          },
          "claims_by_state": {
            "items": {
              "$ref": "#/components/schemas/StateCount"
            },
            "title": "Claims By State",
            "type": "array"
          },
          "denial_rate": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Denied over adjudicated claims, per claim (BR-DATA-03), as a percentage.",
            "title": "Denial Rate"
          },
          "denied_claims": {
            "title": "Denied Claims",
            "type": "integer"
          },
          "first_pass_claims": {
            "title": "First Pass Claims",
            "type": "integer"
          },
          "first_pass_clean": {
            "title": "First Pass Clean",
            "type": "integer"
          },
          "first_pass_clean_rate": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "First submissions neither rejected nor denied, as a percentage.",
            "title": "First Pass Clean Rate"
          },
          "open_work": {
            "title": "Open Work",
            "type": "integer"
          },
          "overdue_work": {
            "title": "Overdue Work",
            "type": "integer"
          },
          "pinned_work": {
            "title": "Pinned Work",
            "type": "integer"
          },
          "steps_awaiting_review": {
            "description": "Automatic claim steps waiting for the submitter's approval (ADR-0006).",
            "title": "Steps Awaiting Review",
            "type": "integer"
          }
        },
        "required": [
          "adjudicated_claims",
          "denied_claims",
          "denial_rate",
          "first_pass_claims",
          "first_pass_clean",
          "first_pass_clean_rate",
          "claims_by_state",
          "open_work",
          "pinned_work",
          "overdue_work",
          "steps_awaiting_review"
        ],
        "title": "DashboardOut",
        "type": "object"
      },
      "DeadlineRiskOut": {
        "description": "UR-26: the alert bar that cannot be dismissed while claims are at risk.",
        "properties": {
          "charges": {
            "description": "Billed charges of the claims at risk, as an exact decimal string to the cent.",
            "title": "Charges",
            "type": "string"
          },
          "claims": {
            "title": "Claims",
            "type": "integer"
          }
        },
        "required": [
          "claims",
          "charges"
        ],
        "title": "DeadlineRiskOut",
        "type": "object"
      },
      "Me": {
        "description": "Who is signed in, and what they may do. No PHI: a staff identity.",
        "properties": {
          "client_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Client Ids",
            "type": "array"
          },
          "permissions": {
            "items": {
              "$ref": "#/components/schemas/Permission"
            },
            "title": "Permissions",
            "type": "array"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/Role"
            },
            "title": "Roles",
            "type": "array"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          }
        },
        "required": [
          "subject",
          "roles",
          "permissions",
          "client_ids"
        ],
        "title": "Me",
        "type": "object"
      },
      "PayerRegistryOut": {
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/components/schemas/RegistryEntryOut"
            },
            "title": "Entries",
            "type": "array"
          },
          "staleness_days": {
            "title": "Staleness Days",
            "type": "integer"
          }
        },
        "required": [
          "entries",
          "staleness_days"
        ],
        "title": "PayerRegistryOut",
        "type": "object"
      },
      "Permission": {
        "description": "What a principal may do. Checked, never inferred from the role name.",
        "enum": [
          "claim:read",
          "claim:write",
          "claim:submit",
          "denial:read",
          "denial:disposition",
          "appeal:sign",
          "coding:read",
          "coding:write",
          "rule:read",
          "rule:author",
          "rule:promote",
          "payer_registry:write",
          "report:read",
          "audit:read",
          "user:admin"
        ],
        "title": "Permission",
        "type": "string"
      },
      "Problem": {
        "description": "RFC 7807 Problem Details (FR-API-04): every error the API returns.\n\nDeclared on each route so the generated client types the error body too.",
        "properties": {
          "code": {
            "description": "Machine-readable error code, stable across releases.",
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Correlates to logs (FR-API-03).",
            "title": "Request Id"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ],
        "title": "Problem",
        "type": "object"
      },
      "QueueItemOut": {
        "description": "One row of a queue (S-02). Charges are billed charges, to the cent.",
        "properties": {
          "assigned_to": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assigned To"
          },
          "bulk_handling": {
            "title": "Bulk Handling",
            "type": "boolean"
          },
          "charges": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Charges"
          },
          "claim_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Claim Id"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "date_of_service": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date Of Service"
          },
          "days_to_deadline": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Days To Deadline"
          },
          "deadline_pinned": {
            "description": "PD-15: always first, never filtered out (UR-03).",
            "title": "Deadline Pinned",
            "type": "boolean"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "overdue": {
            "title": "Overdue",
            "type": "boolean"
          },
          "payer_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payer Id"
          },
          "payer_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payer Name"
          },
          "priority_score": {
            "title": "Priority Score",
            "type": "integer"
          },
          "recovery_probability": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "ML-3's P(recovery). Null until the model exists (M6): the UI shows it as unavailable, never as zero (SRS 10.8 PARTIAL).",
            "title": "Recovery Probability"
          },
          "sla_due_at": {
            "format": "date-time",
            "title": "Sla Due At",
            "type": "string"
          },
          "state": {
            "title": "State",
            "type": "string"
          },
          "submitter_claim_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Submitter Claim Id"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "work_item_id": {
            "format": "uuid",
            "title": "Work Item Id",
            "type": "string"
          }
        },
        "required": [
          "work_item_id",
          "kind",
          "title",
          "state",
          "priority_score",
          "deadline_pinned",
          "days_to_deadline",
          "assigned_to",
          "sla_due_at",
          "overdue",
          "bulk_handling",
          "created_at",
          "claim_id",
          "submitter_claim_id",
          "payer_id",
          "payer_name",
          "date_of_service",
          "charges"
        ],
        "title": "QueueItemOut",
        "type": "object"
      },
      "QueueItemsPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/QueueItemOut"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Pass back as `cursor` for the next page.",
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "QueueItemsPage",
        "type": "object"
      },
      "QueueSummaryOut": {
        "properties": {
          "key": {
            "description": "Stable queue identifier, used in URLs.",
            "title": "Key",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "mine": {
            "description": "Open items held by the signed-in operator.",
            "title": "Mine",
            "type": "integer"
          },
          "open": {
            "title": "Open",
            "type": "integer"
          },
          "overdue": {
            "description": "Open items past their SLA.",
            "title": "Overdue",
            "type": "integer"
          },
          "pinned": {
            "description": "Deadline-pinned items (PD-15), always shown first.",
            "title": "Pinned",
            "type": "integer"
          },
          "unassigned": {
            "title": "Unassigned",
            "type": "integer"
          }
        },
        "required": [
          "key",
          "label",
          "open",
          "unassigned",
          "mine",
          "pinned",
          "overdue"
        ],
        "title": "QueueSummaryOut",
        "type": "object"
      },
      "RegistryEntryOut": {
        "properties": {
          "cpt": {
            "title": "Cpt",
            "type": "string"
          },
          "last_verified_date": {
            "format": "date",
            "title": "Last Verified Date",
            "type": "string"
          },
          "payer_id": {
            "title": "Payer Id",
            "type": "string"
          },
          "payer_name": {
            "title": "Payer Name",
            "type": "string"
          },
          "plan_type": {
            "title": "Plan Type",
            "type": "string"
          },
          "prior_auth_required": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prior Auth Required"
          },
          "stale": {
            "description": "Past [TBD-42]: cannot drive a BLOCKING decision (BR-REG-02).",
            "title": "Stale",
            "type": "boolean"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "payer_id",
          "payer_name",
          "plan_type",
          "cpt",
          "version",
          "prior_auth_required",
          "last_verified_date",
          "stale"
        ],
        "title": "RegistryEntryOut",
        "type": "object"
      },
      "Role": {
        "description": "Operator roles (SRS section 11.5).\n\nDeliberately coarse. A role per job title produces a matrix nobody maintains;\nthese are the five distinct *authority levels* the work actually has.",
        "enum": [
          "AR_SPECIALIST",
          "DENIAL_SPECIALIST",
          "CODER",
          "OPERATIONS_MANAGER",
          "RULES_AUTHOR",
          "ADMINISTRATOR",
          "SYSTEM"
        ],
        "title": "Role",
        "type": "string"
      },
      "RuleOut": {
        "properties": {
          "backtest_flagged": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Backtest Flagged"
          },
          "backtest_fp_rate": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "False-positive rate of the latest backtest, 0-1; null when none has run.",
            "title": "Backtest Fp Rate"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "layer": {
            "title": "Layer",
            "type": "string"
          },
          "rule_id": {
            "title": "Rule Id",
            "type": "string"
          },
          "severity": {
            "title": "Severity",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "rule_id",
          "version",
          "layer",
          "severity",
          "status",
          "created_at",
          "backtest_flagged",
          "backtest_fp_rate"
        ],
        "title": "RuleOut",
        "type": "object"
      },
      "RulesOut": {
        "properties": {
          "rules": {
            "items": {
              "$ref": "#/components/schemas/RuleOut"
            },
            "title": "Rules",
            "type": "array"
          }
        },
        "required": [
          "rules"
        ],
        "title": "RulesOut",
        "type": "object"
      },
      "StateCount": {
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "state": {
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "state",
          "count"
        ],
        "title": "StateCount",
        "type": "object"
      },
      "WorkQueues": {
        "properties": {
          "queues": {
            "items": {
              "$ref": "#/components/schemas/QueueSummaryOut"
            },
            "title": "Queues",
            "type": "array"
          }
        },
        "required": [
          "queues"
        ],
        "title": "WorkQueues",
        "type": "object"
      }
    },
    "securitySchemes": {
      "OIDC bearer token": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "RCM Automation Platform",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/alerts/deadline-risk": {
      "get": {
        "description": "UR-26's alert: claims whose filing deadline has pinned their work, and\ntheir billed charges. Claim money, so it needs `claim:read`.",
        "operationId": "getDeadlineRisk",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeadlineRiskOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No valid bearer token."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The token lacks the permission this route needs."
          }
        },
        "security": [
          {
            "OIDC bearer token": []
          }
        ],
        "summary": "Claims at filing-deadline risk",
        "tags": [
          "shell"
        ]
      }
    },
    "/api/v1/dashboard": {
      "get": {
        "description": "Denial rate, first-pass clean rate, claims by state and queue health.",
        "operationId": "getDashboard",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No valid bearer token."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The token lacks the permission this route needs."
          }
        },
        "security": [
          {
            "OIDC bearer token": []
          }
        ],
        "summary": "KPIs for my clients",
        "tags": [
          "insight"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "description": "The signed-in operator's roles, permissions and client scope.",
        "operationId": "getMe",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No valid bearer token."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The token lacks the permission this route needs."
          }
        },
        "security": [
          {
            "OIDC bearer token": []
          }
        ],
        "summary": "Who is signed in",
        "tags": [
          "shell"
        ]
      }
    },
    "/api/v1/payer-registry": {
      "get": {
        "description": "Current registry entries, each flagged when past [TBD-42] (M4.10).",
        "operationId": "listPayerRegistry",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayerRegistryOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No valid bearer token."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The token lacks the permission this route needs."
          }
        },
        "security": [
          {
            "OIDC bearer token": []
          }
        ],
        "summary": "Payer registry, with staleness",
        "tags": [
          "insight"
        ]
      }
    },
    "/api/v1/rules": {
      "get": {
        "description": "Each rule's latest version, status and latest backtest (M4.4-M4.6).",
        "operationId": "listRules",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RulesOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No valid bearer token."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The token lacks the permission this route needs."
          }
        },
        "security": [
          {
            "OIDC bearer token": []
          }
        ],
        "summary": "Rules, latest version each",
        "tags": [
          "insight"
        ]
      }
    },
    "/api/v1/work-queues": {
      "get": {
        "description": "Each queue the operator's role may work, with its open work, inside\nthe operator's client scope (SRS 7.2, PD-20).",
        "operationId": "listWorkQueues",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkQueues"
