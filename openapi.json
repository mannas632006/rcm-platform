              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No valid bearer token."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The token lacks the permission this route needs."
          }
        },
        "security": [
          {
            "OIDC bearer token": []
          }
        ],
        "summary": "Queues visible to me",
        "tags": [
          "shell"
        ]
      }
    },
    "/api/v1/work-queues/{queue_key}/items": {
      "get": {
        "description": "S-02: the queue in priority order (UR-02), deadline-pinned items first\nand never filtered out (UR-03). Cursor-paginated (FR-API-02).\n\nRows carry claim identifiers and dates of service, so the read is\naudited (PD-2).",
        "operationId": "listQueueItems",
        "parameters": [
          {
            "in": "path",
            "name": "queue_key",
            "required": true,
            "schema": {
              "title": "Queue Key",
              "type": "string"
            }
          },
          {
            "description": "From the previous page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "From the previous page.",
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 200,
