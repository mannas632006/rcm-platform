# Copy to .env for local development. .env is git-ignored and must never be
# committed (CLAUDE.md section 2). Deployed environments inject these from a secret
# manager instead -- there is no code path that reads a credential from a file.

RCM_ENVIRONMENT=local
RCM_DEBUG=false

RCM_DATABASE_URL=postgresql+psycopg://rcm_app:rcm_app@localhost:5432/rcm
RCM_MIGRATION_DATABASE_URL=postgresql+psycopg://rcm_migrator:rcm_migrator@localhost:5432/rcm

RCM_REDIS_URL=redis://localhost:6379/0
RCM_CELERY_BROKER_URL=redis://localhost:6379/1
RCM_CELERY_RESULT_BACKEND=redis://localhost:6379/2

RCM_LOG_LEVEL=INFO
RCM_LOG_JSON=true
