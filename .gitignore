.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
dist/
build/

# Node
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# Secrets and local config -- PD: no credential ever enters the repo (CLAUDE.md section 2)
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Data. Synthetic corpora are regenerated with `make seed`, never committed:
# they are large, and committing them invites someone to commit real data
# to the same path later.
data/
*.835
*.837
*.271
*.277
*.999

# Local tooling
.DS_Store
Thumbs.db
.idea/
.vscode/
!.vscode/extensions.json
mlruns/

# dbt writes these beside its project file (M2.1). `target/` is compiled SQL
# and run artefacts, `logs/` is the run log -- both are build output, and the
# log embeds the compiled SQL of every model, so committing it would also
# commit a copy of the warehouse's source.
src/rcm/analytics/dbt/target/
src/rcm/analytics/dbt/logs/
src/rcm/analytics/dbt/dbt_packages/
src/rcm/analytics/dbt/.user.yml

# tools/verify_ci.py builds this to reproduce CI's environment: a separate
# install from pyproject, with the project's own .venv kept off PATH.
.ci-venv/

# tools/verify_ci.py exports the tree here and runs the stages from it, so
# that nothing the developer's working directory happens to contain -- a
# .venv above all -- is visible to the run.
.ci-run/
